# Server
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
PUBLIC_API_URL=https://backend.atleast80.com

# Default admin (created by npm run migrate)
ADMIN_EMAIL=admin@atleast80.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Atleast80 Admin

# App database user (created by npm run setup:db)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=atleast80_user
MYSQL_PASSWORD=Atleast80@2026
MYSQL_DATABASE=atleast80

# Root credentials — only needed for npm run setup:db
MYSQL_ROOT_HOST=localhost
MYSQL_ROOT_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=your_root_password

# Country State City API (https://countrystatecity.in)
CSC_API_KEY=your_csc_api_key_here

# SMS OTP (smsfortius) — customer signup & forgot-password
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=ELFELO
SMS_TEMPLATE_ID=your_template_id
# Optional: override default OTP message (use {#var#} for OTP)
# SMS_OTP_MESSAGE={#var#} is your Atleast80 otp.valid for 10 minutes only don't share with anyone - ELIFELO PRIVATE LIMITED
