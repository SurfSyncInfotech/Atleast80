# Server
PORT=5000
JWT_SECRET=change_this_to_a_long_random_secret
PUBLIC_API_URL=https://backend.atleast80.com

# Default admin (created by npm run migrate)
ADMIN_EMAIL=admin@atleast80.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Atleast80 Admin

# App database user (created by npm run setup:db)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=atleast80_user
MYSQL_PASSWORD=Atleast80@2026
MYSQL_DATABASE=atleast80

# Root credentials — only needed for npm run setup:db
MYSQL_ROOT_HOST=localhost
MYSQL_ROOT_PORT=3306
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=your_root_password
